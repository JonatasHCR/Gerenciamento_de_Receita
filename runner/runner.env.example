# Copie para runner.env e preencha.

# URL do Gitea acessível desta máquina (ajuste porta/esquema conforme seu Gitea).
GITEA_INSTANCE_URL=http://10.0.0.114:3000

# Token de registro: Gitea → Admin (ou Org/Repo) → Actions → Runners → Create new runner.
GITEA_RUNNER_REGISTRATION_TOKEN=

# Nome do runner (opcional).
GITEA_RUNNER_NAME=runner-ci
