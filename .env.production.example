# Modelo do .env de PRODUÇÃO — copie para o servidor como `.env` (NÃO versionar).
# A imagem é construída localmente no servidor, sem registry.

# Banco de produção (host "db" = serviço do docker-compose.prod.yml).
DATABASE_URL=postgres://receita:TROQUE_ESTA_SENHA@db/receita_production
POSTGRES_USER=receita
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=receita_production

# Conteúdo de config/master.key, que decifra config/credentials.yml.enc.
RAILS_MASTER_KEY=

# App
RAILS_MAX_THREADS=5

# Admin inicial — criado pela task dedicada (NÃO pelo seed de demonstração):
#   docker compose -f docker-compose.prod.yml exec web bin/rails admin:create
# A task concede apenas o PAPEL local; quem guarda credencial é o Keycloak.
ADMIN_EMAIL=admin@suaempresa.com.br

# Backup automático (serviço "backup")
BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=14

# --- SSO ---
# HOST_IP e mantido em dia por infra/scripts/sync_host_ip.py; edite no infra/.env.
# A porta entra no redirect URI do realm — os dois lados precisam concordar.
HOST_IP=
KEYCLOAK_PORT=8080
RECEITA_PORT=3040
PORTAL_PORT=3080
OIDC_CLIENT_ID=receita-web
OIDC_CLIENT_SECRET=

# Token da API de sincronizacao (o inventario le os centros de custo daqui).
# Gere com: openssl rand -hex 32
SYNC_API_TOKEN=

# Portas dos demais sistemas (seletor "Sistemas" no menu).
INVENTARIO_PORT=3030
DESPESA_PORT=3010
