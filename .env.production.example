# Modelo do .env de PRODUÇÃO — copie para o servidor, em DEPLOY_PATH, como `.env`.
# (NÃO versionar o .env preenchido.)

# Imagem publicada no registry (mesmo valor do WEB_IMAGE usado no deploy).
# Formato: <REGISTRY_HOST>/<owner>/<repo>:latest
WEB_IMAGE=10.0.0.114:3000/seu_usuario/gerencimento_receita:latest

# Banco de produção (host "db" = serviço do docker-compose.prod.yml).
DATABASE_URL=postgres://receita:TROQUE_ESTA_SENHA@db/receita_production
POSTGRES_USER=receita
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=receita_production

# Chave para descriptografar config/credentials.yml.enc (conteúdo de config/master.key).
RAILS_MASTER_KEY=

# App
RAILS_MAX_THREADS=5
WEB_PORT=80

# Backup automático (serviço "backup")
BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=14
