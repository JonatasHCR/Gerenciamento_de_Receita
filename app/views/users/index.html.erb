<% content_for :title, "Usuários" %>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold text-gray-900">Usuários</h1>
    <%= link_to "Novo Usuário", new_user_path,
          class: "rounded-lg bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800" %>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <% if @users.any? %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="px-5 py-3 text-left">Nome</th>
            <th class="px-5 py-3 text-left">E-mail</th>
            <th class="px-5 py-3 text-center">Perfil</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @users.each do |user| %>
            <tr class="hover:bg-gray-50">
              <td class="px-5 py-3 font-medium text-gray-900">
                <%= user.name %>
                <% if user == current_user %>
                  <span class="ml-2 text-xs text-gray-400">(você)</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-gray-600"><%= user.email %></td>
              <td class="px-5 py-3 text-center">
                <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= role_badge_class(user.role) %>">
                  <%= user.role.capitalize %>
                </span>
              </td>
              <td class="px-5 py-3 text-right flex justify-end gap-3">
                <%= link_to "Editar", edit_user_path(user), class: "text-red-600 hover:underline" %>
                <% if user != current_user %>
                  <%= button_to "Excluir", user_path(user), method: :delete,
                        data: { turbo_confirm: "Confirma a exclusão do usuário #{user.name}?" },
                        class: "text-red-500 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="py-12 text-center text-sm text-gray-400">Nenhum usuário cadastrado.</p>
    <% end %>
  </div>
</div>
