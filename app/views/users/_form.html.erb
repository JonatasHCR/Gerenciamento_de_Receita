<% is_profile = defined?(@is_profile) && @is_profile %>
<% form_target = is_profile ? profile_path : nil %>
<%= form_with model: user, url: form_target, method: (is_profile ? :patch : nil), class: "space-y-4" do |f| %>
  <% if user.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-700 text-sm">
      <ul class="list-disc list-inside space-y-1">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="sm:col-span-2">
      <%= f.label :name, req("Nome completo"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
    </div>

    <div>
      <%= f.label :email, req("E-mail"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autocomplete: "off",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
    </div>

    <% if current_user.admin? %>
      <div>
        <%= f.label :role, req("Perfil de acesso"), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :role,
              User.roles.keys.map { |r| [r.capitalize, r] },
              {},
              class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
      </div>
    <% end %>

    <div>
      <%= password_field_with_toggle f, :password,
            (user.persisted? ? (is_profile ? "Nova senha" : "Senha") : req("Senha")),
            autocomplete: "new-password" %>
      <% if user.persisted? %>
        <p class="mt-1 text-xs text-gray-400">Deixe em branco para manter a senha atual.</p>
      <% end %>
    </div>

    <div>
      <%= password_field_with_toggle f, :password_confirmation, "Confirmar senha", autocomplete: "new-password" %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit is_profile ? "Salvar perfil" : nil,
          class: "rounded-lg bg-red-700 px-5 py-2 text-sm font-medium text-white hover:bg-red-800 cursor-pointer" %>
    <% if is_profile %>
      <%= link_to "Cancelar", edit_profile_path,
            class: "rounded-lg border border-gray-300 px-5 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
    <% else %>
      <%= link_to "Cancelar", users_path,
            class: "rounded-lg border border-gray-300 px-5 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
    <% end %>
  </div>
<% end %>
