<% is_profile = defined?(@is_profile) && @is_profile %>
<% content_for :title, is_profile ? "Meu Perfil" : "Editar Usuário" %>

<div class="max-w-2xl">
  <div class="flex items-center gap-4 mb-6">
    <% if is_profile %>
      <div class="w-14 h-14 rounded-full bg-red-100 text-red-700 flex items-center justify-center text-2xl font-bold flex-shrink-0">
        <%= @user.name[0].upcase %>
      </div>
      <div>
        <h1 class="text-xl font-semibold text-gray-900">Meu Perfil</h1>
        <p class="text-sm text-gray-500 mt-0.5">
          <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= role_badge_class(@user.role) %>">
            <%= @user.role.capitalize %>
          </span>
          <span class="ml-2 text-gray-400"><%= @user.email %></span>
        </p>
      </div>
    <% else %>
      <%= link_to "← Voltar", users_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <h1 class="text-xl font-semibold text-gray-900">Editar <%= @user.name %></h1>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <%= render "form", user: @user %>
  </div>
</div>
