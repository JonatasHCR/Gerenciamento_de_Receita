<% content_for :title, "Editar Previsão" %>

<div class="max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Voltar", forecast_entries_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="text-xl font-semibold text-gray-900">
      Editar Previsão — <%= @entry.cost_center.cr_code %> / <%= @entry.month_year %>
    </h1>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <%= render "form", entry: @entry %>
  </div>
</div>
