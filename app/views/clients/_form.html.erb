<%= form_with model: client, class: "space-y-4" do |f| %>
  <% if client.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-700 text-sm">
      <ul class="list-disc list-inside space-y-1">
        <% client.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, "Sigla (ex: CERB)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
    </div>
    <div>
      <%= f.label :full_name, "Nome Completo", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :full_name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-red-700 px-5 py-2 text-sm font-medium text-white hover:bg-red-800 cursor-pointer" %>
    <%= link_to "Cancelar", clients_path, class: "rounded-lg border border-gray-300 px-5 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
