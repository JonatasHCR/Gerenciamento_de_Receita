<% content_for :title, "Relatórios" %>

<div class="space-y-6">
  <h1 class="text-xl font-semibold text-gray-900">Relatórios</h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <% if current_user.admin_or_financeiro? %>
      <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
        <div>
          <h2 class="text-sm font-semibold text-gray-800">Relatório Mensal de Receitas (PDF)</h2>
          <p class="text-xs text-gray-500 mt-1">
            Previsto · Faturado · Em aberto anterior · Recebido · Faturas em aberto, por cliente e CC.
            Por mês (padrão) ou por período.
          </p>
        </div>

        <%= form_with url: monthly_report_path, method: :get, data: { turbo: false }, class: "space-y-3" do |f| %>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Por mês</label>
            <%= f.month_field :month, value: Date.current.strftime("%Y-%m"),
                  class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-red-500" %>
          </div>

          <div class="border-t border-gray-100 pt-3">
            <label class="block text-xs text-gray-500 mb-1">Ou por período (preencha as duas datas)</label>
            <div class="flex flex-wrap items-center gap-2">
              <%= f.date_field :start,
                    class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-red-500" %>
              <span class="text-xs text-gray-400">até</span>
              <%= f.date_field :end,
                    class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-red-500" %>
            </div>
            <p class="text-xs text-gray-400 mt-1">Com as datas preenchidas, o período prevalece sobre o mês.</p>
          </div>

          <%= f.submit "📄 Gerar PDF",
                class: "rounded-lg bg-orange-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-orange-700 cursor-pointer" %>
        <% end %>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
      <div>
        <h2 class="text-sm font-semibold text-gray-800">Relação de Compromissos</h2>
        <p class="text-xs text-gray-500 mt-1">
          Nº Contrato, Contratante, Centro de Resultado, Objeto, Início, Fim, Valor, % a Executar e Saldo.
          O Excel traz ainda o detalhamento UFC.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "📊 Baixar Excel", report_cost_centers_path(output: "xlsx"),
              data: { turbo: false },
              class: "inline-block rounded-lg border border-green-600 px-4 py-1.5 text-sm font-medium text-green-700 hover:bg-green-50" %>
        <%= link_to "📕 Baixar PDF", report_cost_centers_path(output: "pdf"),
              data: { turbo: false },
              class: "inline-block rounded-lg border border-red-600 px-4 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50" %>
      </div>
    </div>

    <% if current_user.admin_or_financeiro? %>
      <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4" data-controller="check-all">
        <div>
          <h2 class="text-sm font-semibold text-gray-800">Relação das Faturas em Aberto (PDF / Excel)</h2>
          <p class="text-xs text-gray-500 mt-1">
            NFs com saldo em aberto por cliente → centro de custo (CLIENTE, NF, emissão, CC, contrato, valor).
            Marque <strong>um ou mais clientes</strong> (nenhum = todos).
          </p>
        </div>

        <%= form_with url: open_invoices_report_path, method: :get, data: { turbo: false }, class: "space-y-3" do %>
          <div class="flex items-center justify-between">
            <span class="block text-xs text-gray-500">Clientes</span>
            <label class="flex items-center gap-1 text-xs text-gray-500 cursor-pointer">
              <input type="checkbox" data-action="change->check-all#toggle"
                     class="rounded border-gray-300 text-red-600 focus:ring-red-500">
              marcar/desmarcar todos
            </label>
          </div>
          <%= hidden_field_tag "client_ids[]", "" %>
          <div class="max-h-56 overflow-y-auto rounded-lg border border-gray-200 divide-y divide-gray-100">
            <% Client.order(:name).each do |client| %>
              <label class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer">
                <%= check_box_tag "client_ids[]", client.id, false,
                      data: { "check-all-target": "item" },
                      class: "rounded border-gray-300 text-red-600 focus:ring-red-500" %>
                <span><%= client.name %></span>
              </label>
            <% end %>
          </div>

          <div class="flex gap-2 pt-1">
            <button type="submit" name="output" value="pdf"
                    class="rounded-lg bg-orange-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-orange-700 cursor-pointer">📄 PDF</button>
            <button type="submit" name="output" value="xlsx"
                    class="rounded-lg border border-green-600 px-4 py-1.5 text-sm font-medium text-green-700 hover:bg-green-50 cursor-pointer">📊 Excel</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Novos relatórios entram como cards aqui. %>
  </div>
</div>
