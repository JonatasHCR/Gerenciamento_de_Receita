<% content_for :title, "Relatórios" %>

<div class="space-y-6">
  <h1 class="text-xl font-semibold text-gray-900">Relatórios</h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <% if current_user.admin_or_financeiro? %>
      <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
        <div>
          <h2 class="text-sm font-semibold text-gray-800">Relatório Mensal de Receitas (PDF)</h2>
          <p class="text-xs text-gray-500 mt-1">
            Previsto · Faturado · Em aberto anterior · Recebido · Faturas em aberto, por centro de custo.
            Por mês (padrão) ou por período.
          </p>
        </div>

        <%= form_with url: monthly_report_path, method: :get, data: { turbo: false }, class: "space-y-3" do |f| %>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Por mês</label>
            <%= f.month_field :month, value: Date.current.strftime("%Y-%m"),
                  class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-red-500" %>
          </div>

          <div class="border-t border-gray-100 pt-3">
            <label class="block text-xs text-gray-500 mb-1">Ou por período (preencha as duas datas)</label>
            <div class="flex flex-wrap items-center gap-2">
              <%= f.date_field :start,
                    class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-red-500" %>
              <span class="text-xs text-gray-400">até</span>
              <%= f.date_field :end,
                    class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-red-500" %>
            </div>
            <p class="text-xs text-gray-400 mt-1">Com as datas preenchidas, o período prevalece sobre o mês.</p>
          </div>

          <%= render "reports/scope_filter", default_group_by: "cliente", id_prefix: "monthly" %>

          <%= f.submit "📄 Gerar PDF",
                class: "rounded-lg bg-orange-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-orange-700 cursor-pointer" %>
        <% end %>
      </div>
    <% end %>

    <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
      <div>
        <h2 class="text-sm font-semibold text-gray-800">Relação de Compromissos</h2>
        <p class="text-xs text-gray-500 mt-1">
          Nº Contrato, Contratante, Centro de Resultado, Objeto, Início, Fim, Valor, % a Executar e Saldo.
          O Excel traz ainda o detalhamento UFC.
        </p>
      </div>

      <%= form_with url: report_cost_centers_path, method: :get, data: { turbo: false }, class: "space-y-3" do %>
        <%= render "reports/scope_filter", default_group_by: "centro_custo", id_prefix: "commitments" %>

        <div class="flex flex-wrap gap-2 pt-1">
          <button type="submit" name="output" value="xlsx"
                  class="rounded-lg border border-green-600 px-4 py-1.5 text-sm font-medium text-green-700 hover:bg-green-50 cursor-pointer">📊 Baixar Excel</button>
          <button type="submit" name="output" value="pdf"
                  class="rounded-lg border border-red-600 px-4 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 cursor-pointer">📕 Baixar PDF</button>
        </div>
      <% end %>
    </div>

    <% if current_user.admin_or_financeiro? %>
      <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4 lg:col-span-2">
        <div>
          <h2 class="text-sm font-semibold text-gray-800">Relatório de Movimentação (PDF / Excel)</h2>
          <p class="text-xs text-gray-500 mt-1">
            Faturamento (por <strong>data de emissão</strong>) e/ou recebimento (por <strong>data de baixa</strong>),
            destacando e totalizando o que está <strong>em aberto</strong>. Subtotais em cada nível do agrupamento.
          </p>
        </div>

        <%= form_with url: movement_report_path, method: :get,
              data: { turbo: false, controller: "movement-options" }, class: "space-y-3" do |f| %>
          <fieldset>
            <legend class="block text-xs text-gray-500 mb-1">Tipo</legend>
            <div class="flex flex-wrap gap-4">
              <% [["ambos", "Ambos"], ["faturamento", "Faturamento"], ["recebimento", "Recebimento"]].each do |value, label| %>
                <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                  <%= radio_button_tag "tipo", value, value == "ambos", id: nil,
                        data: { "movement-options-target": "tipo",
                                action: "change->movement-options#toggle" },
                        class: "border-gray-300 text-red-600 focus:ring-red-500" %>
                  <%= label %>
                </label>
              <% end %>
            </div>
          </fieldset>

          <%# Só faz sentido com faturamento — some no tipo "recebimento". %>
          <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer"
                 data-movement-options-target="onlyOpen">
            <%= check_box_tag "only_open", "1", false, id: nil,
                  data: { "movement-options-target": "onlyOpenBox" },
                  class: "rounded border-gray-300 text-red-600 focus:ring-red-500" %>
            Somente faturas em aberto
          </label>

          <div>
            <label class="block text-xs text-gray-500 mb-1">Período (opcional — vazio = tudo)</label>
            <div class="flex flex-wrap items-center gap-2">
              <%= f.date_field :start,
                    class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-red-500" %>
              <span class="text-xs text-gray-400">até</span>
              <%= f.date_field :end,
                    class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-red-500" %>
            </div>
            <p class="text-xs text-gray-400 mt-1">
              Faturamento é recortado pela data de emissão; recebimento, pela data de baixa.
            </p>
          </div>

          <%= render "reports/scope_filter", default_group_by: "cliente", id_prefix: "movement" %>

          <div class="flex gap-2 pt-1">
            <button type="submit" name="output" value="pdf"
                    class="rounded-lg bg-orange-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-orange-700 cursor-pointer">📄 PDF</button>
            <button type="submit" name="output" value="xlsx"
                    class="rounded-lg border border-green-600 px-4 py-1.5 text-sm font-medium text-green-700 hover:bg-green-50 cursor-pointer">📊 Excel</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Novos relatórios entram como cards aqui. %>
  </div>
</div>
