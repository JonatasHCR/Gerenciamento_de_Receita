<% content_for :title, "Recebimentos" %>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold text-gray-900">Recebimentos</h1>
    <% if policy(Receipt).create? %>
      <%= link_to "Registrar Recebimento", new_receipt_path,
            class: "rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700" %>
    <% end %>
  </div>

  <%# Filters %>
  <%= form_with url: receipts_path, method: :get, class: "bg-white rounded-xl border border-gray-200 p-4 flex flex-wrap gap-3" do |f| %>
    <div>
      <%= f.label :month, "Mês", class: "block text-xs text-gray-500 mb-1" %>
      <%= f.month_field :month, value: params[:month],
            class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
    </div>
    <div>
      <%= f.label :cost_center_id, "Centro de Custo", class: "block text-xs text-gray-500 mb-1" %>
      <%= f.select :cost_center_id,
            policy_scope(CostCenter).order(:cr_code).map { |cc| ["#{cc.cr_code} — #{cc.description}", cc.id] },
            { include_blank: "Todos", selected: params[:cost_center_id] },
            class: "w-40 sm:w-56 max-w-full rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
    </div>
    <div class="flex items-end gap-2">
      <%= f.submit "Filtrar", class: "rounded-lg bg-red-800 px-4 py-1.5 text-sm text-white hover:bg-red-900 cursor-pointer" %>
      <%= link_to "Limpar", receipts_path, class: "text-sm text-gray-500 hover:underline self-center" %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <% if @receipts.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="px-4 py-3 text-left">Data</th>
              <th class="px-4 py-3 text-left">NF</th>
              <th class="px-4 py-3 text-left">Centro de Custo</th>
              <th class="px-4 py-3 text-left">Cliente</th>
              <th class="px-4 py-3 text-right">Valor Recebido</th>
              <th class="px-4 py-3 text-left">Observações</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @receipts.each do |receipt| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-gray-700"><%= receipt.payment_date&.strftime("%d/%m/%Y") %></td>
                <td class="px-4 py-3 font-medium text-gray-900">
                  <%= link_to receipt.invoice.number, invoice_path(receipt.invoice),
                        class: "text-red-600 hover:underline", data: { turbo_frame: "_top" } %>
                </td>
                <td class="px-4 py-3 text-gray-600"><%= receipt.invoice.cost_center&.cr_code %></td>
                <td class="px-4 py-3 text-gray-600 max-w-xs truncate"><%= receipt.invoice.client_name %></td>
                <td class="px-4 py-3 text-right font-medium text-green-700"><%= brl(receipt.value) %></td>
                <td class="px-4 py-3 text-gray-500 max-w-xs truncate"><%= receipt.observations %></td>
                <td class="px-4 py-3 text-right">
                  <% if policy(receipt).update? %>
                    <%= link_to "Editar", edit_receipt_path(receipt), class: "text-red-600 hover:underline" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-4 py-3 border-t border-gray-100 flex items-center justify-between text-sm text-gray-500">
        <span>Total: <strong class="text-gray-900"><%= brl(@receipts.sum(&:value)) %></strong></span>
        <%== @pagy.series_nav if @pagy.pages > 1 %>
      </div>
    <% else %>
      <p class="py-12 text-center text-sm text-gray-400">Nenhum recebimento encontrado.</p>
    <% end %>
  </div>
</div>
