<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-lg px-8 py-10">
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold text-red-700">UFC Engenharia</h1>
        <p class="mt-1 text-sm text-gray-500">Criar nova senha</p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <% if resource.errors.any? %>
          <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-700 text-sm">
            <%= resource.errors.full_messages.first %>
          </div>
        <% end %>

        <%= f.hidden_field :reset_password_token %>

        <div class="space-y-4">
          <div>
            <%= f.label :password, "Nova senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                  class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm
                          focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
            <% if @minimum_password_length %>
              <p class="mt-1 text-xs text-gray-400">Mínimo de <%= @minimum_password_length %> caracteres</p>
            <% end %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirmar nova senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password",
                  class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm
                          focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
          </div>

          <%= f.submit "Redefinir senha",
                class: "w-full mt-2 rounded-lg bg-red-700 px-4 py-2.5 text-sm font-semibold
                        text-white hover:bg-red-800 focus:outline-none focus:ring-2
                        focus:ring-red-500 transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <%= link_to "Voltar para o login", new_user_session_path,
              class: "text-sm text-orange-600 hover:underline" %>
      </div>
    </div>
  </div>
</div>
