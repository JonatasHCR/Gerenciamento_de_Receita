<% content_for :title, "Importar Planilha" %>

<div class="max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Voltar", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="text-xl font-semibold text-gray-900">Importar Planilha Excel</h1>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
    <div class="rounded-lg bg-orange-50 border border-orange-200 px-4 py-3 text-orange-700 text-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-medium mb-1">Formato esperado</p>
          <ul class="list-disc list-inside space-y-1 text-xs">
            <li>Arquivo <strong>.xlsx</strong> com as 4 abas abaixo (use o modelo ao lado).</li>
            <li><strong>CADASTRO CENTRO DE CUSTO</strong>: CR, Participação, Descrição, Cliente.</li>
            <li><strong>PREVISAO FATURAMENTO</strong>: CR, Participação, <em>Objeto</em>, Descrição, Cliente,
                <em>Data Final</em>, <em>Coordenador(es)</em>, Previsto, % UFC. O mês/ano fica na célula <strong>I3</strong>.</li>
            <li><strong>FATURAMENTO</strong>: NF, CR, Cliente, Data de Emissão, Valor, Observação.</li>
            <li><strong>RECEBIMENTO</strong>: NF, CR, Data de Baixa, Valor, Observação.</li>
          </ul>
          <p class="font-medium mt-2 mb-1">Instruções de preenchimento</p>
          <ul class="list-disc list-inside space-y-1 text-xs">
            <li><strong>Participação:</strong> informe em <strong>percentual (0 a 100)</strong> — ex.: 100 = 100%, 50 = 50%.</li>
            <li><strong>Vários coordenadores/gestores:</strong> separe os nomes com barra <strong>" / "</strong> na mesma célula (ex.: <em>Ana Maria / Dr. João</em>).</li>
            <li><strong>Objeto, Data Final e Coordenador</strong> são lidos da aba <strong>PREVISÃO</strong> (não precisa repetir na CADASTRO).</li>
            <li>As colunas são localizadas pelo <strong>cabeçalho</strong>: a ordem é livre e colunas extras (ex.: "Mês", "Centro de Custo") são ignoradas. Basta a data — não precisa de coluna de mês.</li>
            <li>O <strong>Realizado</strong> da previsão é calculado automaticamente pelo faturamento — não precisa preencher.</li>
            <li>CR já existente é <strong>atualizado</strong> (reimportar não duplica). CR sem cliente entra como “NÃO INFORMADO”.</li>
            <li>Linhas com erro são ignoradas e <strong>sinalizadas</strong> ao final; as demais são importadas normalmente.</li>
          </ul>
        </div>
        <%= link_to template_imports_path,
              class: "flex-shrink-0 flex items-center gap-2 rounded-lg border border-orange-300 bg-white
                      px-3 py-2 text-xs font-medium text-orange-700 hover:bg-orange-50 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          </svg>
          Baixar Modelo
        <% end %>
      </div>
    </div>

    <%= form_with url: imports_path, method: :post, multipart: true, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :file, "Arquivo Excel (.xlsx)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.file_field :file, accept: ".xlsx",
              class: "w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4
                      file:rounded-lg file:border-0 file:text-sm file:font-medium
                      file:bg-red-50 file:text-red-700 hover:file:bg-red-100
                      border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

      <% if @fatal_error.present? %>
        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-700 text-sm">
          <p class="font-medium"><%= @fatal_error %></p>
        </div>
      <% end %>

      <% if defined?(@import_count) && @import_count.present? %>
        <div class="rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-green-800 text-sm">
          <p class="font-medium">
            ✓ <%= @import_count %> registro(s) importado(s) com sucesso<%= @errors.present? ? "." : " (nenhum erro)." %>
          </p>
        </div>
      <% end %>

      <% if defined?(@errors) && @errors.present? %>
        <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-amber-800 text-sm">
          <p class="font-medium mb-1">
            ⚠️ <%= @errors.size %> linha(s) ignorada(s) por erro — as demais foram importadas:
          </p>
          <ul class="list-disc list-inside space-y-1 max-h-64 overflow-y-auto">
            <% @errors.each do |err| %>
              <li class="text-xs"><%= err %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= f.submit "Importar",
            class: "w-full rounded-lg bg-red-700 px-4 py-2.5 text-sm font-semibold
                    text-white hover:bg-red-800 focus:outline-none focus:ring-2
                    focus:ring-red-500 transition-colors cursor-pointer" %>
    <% end %>
  </div>
</div>
