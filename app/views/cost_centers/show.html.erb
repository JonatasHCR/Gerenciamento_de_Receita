<% content_for :title, "CC #{@cost_center.cr_code}" %>

<div class="space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to "← Voltar", cost_centers_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="text-xl font-semibold text-gray-900">
      <%= @cost_center.cr_code %> — <%= @cost_center.description %>
    </h1>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Details %>
    <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 p-6 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Cliente</p>
          <p class="mt-1 font-medium text-gray-900"><%= @cost_center.client&.name %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Nº do Contrato</p>
          <p class="mt-1 font-medium text-gray-900"><%= @cost_center.contract_number.presence || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Coordenador(es)</p>
          <p class="mt-1 font-medium text-gray-900"><%= @cost_center.coordinator.presence || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Participação UFC</p>
          <p class="mt-1 font-medium text-gray-900">
            <%= number_to_percentage((@cost_center.participation || 0) * 100, precision: 0) %>
          </p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Início</p>
          <p class="mt-1 font-medium text-gray-900"><%= @cost_center.start_date&.strftime("%d/%m/%Y") || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Data Final</p>
          <p class="mt-1 font-medium text-gray-900"><%= @cost_center.end_date&.strftime("%d/%m/%Y") || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Valor do Contrato</p>
          <p class="mt-1 font-medium text-gray-900"><%= brl(@cost_center.value || 0) %></p>
        </div>
        <% parcial = (@cost_center.participation || 0) < 1 %>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide"><%= parcial ? "Saldo UFC (participação aplicada)" : "Saldo" %></p>
          <p class="mt-1 font-bold <%= @cost_center.saldo_ufc < 0 ? 'text-red-600' : 'text-green-600' %>"><%= brl(@cost_center.saldo_ufc) %></p>
          <% if parcial %>
            <p class="text-xs text-gray-400">Saldo total do contrato: <%= brl(@cost_center.saldo) %></p>
          <% end %>
        </div>
        <% if @cost_center.object_text.present? %>
          <div class="sm:col-span-2">
            <p class="text-xs text-gray-500 uppercase tracking-wide">Objeto</p>
            <p class="mt-1 text-gray-700 leading-relaxed"><%= @cost_center.object_text %></p>
          </div>
        <% end %>
      </div>

      <% if policy(@cost_center).update? %>
        <div class="flex gap-3 pt-2 border-t border-gray-100">
          <%= link_to "Editar", edit_cost_center_path(@cost_center),
                class: "rounded-lg border border-gray-300 px-4 py-2 text-sm hover:bg-gray-50" %>
          <% if policy(@cost_center).destroy? %>
            <%= button_to "Excluir", cost_center_path(@cost_center), method: :delete,
                  data: { turbo_confirm: "Confirma a exclusão deste centro de custo?" },
                  class: "rounded-lg border border-red-300 px-4 py-2 text-sm text-red-600 hover:bg-red-50" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Reajustes (valor / prazo) + histórico %>
    <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
      <h2 class="font-semibold text-gray-700 text-sm">Reajustes</h2>

      <% if policy(@cost_center).update? %>
        <%# Reajuste de VALOR %>
        <%= form_with url: cost_center_adjustments_path(@cost_center), method: :post, class: "space-y-2" do |f| %>
          <%= hidden_field_tag "adjustment[kind]", "valor" %>
          <label class="block text-xs text-gray-500">Reajuste de Valor (R$)</label>
          <div class="flex gap-2" data-controller="currency">
            <div class="relative flex-1">
              <span class="absolute inset-y-0 left-3 flex items-center text-sm text-gray-500 pointer-events-none">R$</span>
              <input type="text" inputmode="numeric" placeholder="Novo valor" autocomplete="off"
                     class="w-full rounded-lg border border-gray-300 pl-9 pr-3 py-1.5 text-sm"
                     data-currency-target="display" data-action="input->currency#format">
              <%= hidden_field_tag "adjustment[new_value]", nil, data: { "currency-target": "input" } %>
            </div>
            <%= f.submit "Aplicar", class: "rounded-lg bg-red-700 px-3 py-1.5 text-sm text-white hover:bg-red-800 cursor-pointer" %>
          </div>
        <% end %>

        <%# Reajuste de PRAZO %>
        <%= form_with url: cost_center_adjustments_path(@cost_center), method: :post, class: "space-y-2 pt-2 border-t border-gray-100" do |f| %>
          <%= hidden_field_tag "adjustment[kind]", "prazo" %>
          <label class="block text-xs text-gray-500">Reajuste de Prazo (nova Data Final)</label>
          <div class="flex gap-2">
            <%= date_field_tag "adjustment[new_date]", nil,
                  class: "flex-1 rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
            <%= f.submit "Aplicar", class: "rounded-lg bg-red-700 px-3 py-1.5 text-sm text-white hover:bg-red-800 cursor-pointer" %>
          </div>
        <% end %>
      <% end %>

      <%# Histórico %>
      <div class="pt-2 border-t border-gray-100">
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-2">Histórico</p>
        <% if @adjustments.any? %>
          <ul class="space-y-2 text-sm">
            <% @adjustments.each do |adj| %>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-xs px-1.5 py-0.5 rounded-full font-medium <%= adj.valor? ? 'bg-orange-100 text-orange-700' : 'bg-blue-100 text-blue-700' %>">
                  <%= adj.valor? ? "Valor" : "Prazo" %>
                </span>
                <div class="flex-1">
                  <% if adj.valor? %>
                    <span class="text-gray-700"><%= brl(adj.previous_value || 0) %> → <strong><%= brl(adj.new_value) %></strong></span>
                  <% else %>
                    <span class="text-gray-700"><%= adj.previous_date&.strftime("%d/%m/%Y") || "—" %> → <strong><%= adj.new_date&.strftime("%d/%m/%Y") %></strong></span>
                  <% end %>
                  <span class="block text-xs text-gray-400"><%= l(adj.created_at, format: :short) %><%= " — #{adj.note}" if adj.note.present? %></span>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-gray-400">Nenhum reajuste registrado.</p>
        <% end %>
      </div>
    </div>
  </div>

  <%# Recent Invoices %>
  <div class="bg-white rounded-xl border border-gray-200">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="font-semibold text-gray-700 text-sm">Notas Fiscais</h2>
      <%= link_to "Ver todas →", invoices_path(cost_center_id: @cost_center.id),
            class: "text-sm text-red-600 hover:underline" %>
    </div>
    <% recent_invoices = @cost_center.invoices.ordered.limit(10) %>
    <% if recent_invoices.any? %>
      <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="px-5 py-3 text-left">NF</th>
            <th class="px-5 py-3 text-left">Emissão</th>
            <th class="px-5 py-3 text-right">Valor</th>
            <th class="px-5 py-3 text-center">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% recent_invoices.each do |inv| %>
            <tr class="hover:bg-gray-50">
              <td class="px-5 py-3">
                <%= link_to inv.number, invoice_path(inv), class: "text-red-600 hover:underline" %>
              </td>
              <td class="px-5 py-3 text-gray-500"><%= inv.issued_at&.strftime("%d/%m/%Y") %></td>
              <td class="px-5 py-3 text-right font-medium text-gray-900"><%= brl(inv.value) %></td>
              <td class="px-5 py-3 text-center"><%= payment_status_badge(inv) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
    <% else %>
      <p class="py-8 text-center text-sm text-gray-400">Nenhuma nota fiscal para este CC.</p>
    <% end %>
  </div>
</div>
