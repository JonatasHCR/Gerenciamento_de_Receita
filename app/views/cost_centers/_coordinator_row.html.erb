<div data-coordinators-target="row" class="flex items-center gap-2">
  <input type="text" name="cost_center[coordinator_list][]" value="<%= name %>"
         list="coordinator_options" autocomplete="off"
         placeholder="Nome do coordenador/gestor"
         class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500">
  <button type="button" data-action="coordinators#remove" title="Remover"
          class="flex-shrink-0 rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-500 hover:bg-red-50 hover:text-red-600">✕</button>
</div>
