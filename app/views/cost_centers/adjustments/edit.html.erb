<% content_for :title, "Editar Reajuste" %>

<div class="max-w-xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Voltar para o Centro de Custo", cost_center_path(@cost_center),
          class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="text-xl font-semibold text-gray-900">Editar Reajuste</h1>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <%= form_with model: @adjustment, url: adjustment_path(@adjustment), method: :patch, class: "space-y-4" do |f| %>
      <% if @adjustment.errors.any? %>
        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-700 text-sm">
          <ul class="list-disc list-inside space-y-1">
            <% @adjustment.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <dl class="text-sm text-gray-500 space-y-1">
        <div class="flex gap-2">
          <dt>Centro de Custo:</dt>
          <dd class="text-gray-800 font-medium"><%= @cost_center.cr_code %> — <%= @cost_center.description %></dd>
        </div>
        <div class="flex gap-2">
          <dt>Registrado em:</dt>
          <dd class="text-gray-800"><%= l(@adjustment.created_at, format: :short) %></dd>
        </div>
      </dl>

      <% if @adjustment.valor? %>
        <div>
          <%= money_field f, :amount, "Valor do Reajuste" %>
          <p class="mt-1 text-xs text-gray-400">
            Valor do contrato antes deste reajuste: <strong><%= brl(@adjustment.previous_value || 0) %></strong>.
            Alterar aqui recalcula o valor do contrato e os reajustes posteriores.
          </p>
        </div>
      <% else %>
        <div>
          <%= f.label :new_date, req("Nova Data Final"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :new_date, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
          <p class="mt-1 text-xs text-gray-400">
            Data final antes deste reajuste: <strong><%= @adjustment.previous_date&.strftime("%d/%m/%Y") || "—" %></strong>.
          </p>
        </div>
      <% end %>

      <div>
        <%= f.label :note, "Observação", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :note, rows: 2,
              class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
      </div>

      <div class="flex gap-3 pt-2">
        <%= f.submit "Salvar", class: "rounded-lg bg-red-700 px-5 py-2 text-sm font-medium text-white hover:bg-red-800 cursor-pointer" %>
        <%= link_to "Cancelar", cost_center_path(@cost_center),
              class: "rounded-lg border border-gray-300 px-5 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>
</div>
