<%
  cc_client_map = CostCenter.includes(:client).each_with_object({}) do |cc, h|
    h[cc.id.to_s] = cc.client&.name.to_s
  end
%>
<%= form_with model: invoice, class: "space-y-4",
      data: { controller: "cost-center-client",
              "cost-center-client-map-value": cc_client_map.to_json } do |f| %>
  <% if invoice.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-700 text-sm">
      <ul class="list-disc list-inside space-y-1">
        <% invoice.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :number, "Número da NF", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :number, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
    </div>

    <div>
      <%= f.label :cost_center_id, "Centro de Custo", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :cost_center_id,
            CostCenter.order(:cr_code), :id, ->(cc) { "#{cc.cr_code} — #{cc.description}" },
            { include_blank: "Selecione..." },
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500",
            data: { "cost-center-client-target": "costCenter", action: "change->cost-center-client#fill" } %>
    </div>

    <div>
      <%= f.label :client_name, "Cliente", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :client_name,
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500",
            data: { "cost-center-client-target": "clientName" } %>
    </div>

    <div>
      <%= f.label :issued_at, "Data de Emissão", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :issued_at, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
    </div>

    <div>
      <%= f.label :value, "Valor (R$)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :value, step: "0.01", min: "0",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
    </div>

    <div class="sm:col-span-2">
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <%= f.check_box :kind, { checked: invoice.reajuste? }, "reajuste", "principal" %>
        É <strong>reajuste</strong>? (deixe desmarcado para faturamento <strong>principal</strong> — só o principal conta no saldo do contrato)
      </label>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :observations, "Observações", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :observations, rows: 3,
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500" %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-red-700 px-5 py-2 text-sm font-medium text-white hover:bg-red-800 cursor-pointer" %>
    <%= link_to "Cancelar", invoices_path, class: "rounded-lg border border-gray-300 px-5 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
