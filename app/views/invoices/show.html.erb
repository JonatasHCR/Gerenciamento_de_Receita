<% content_for :title, "NF #{@invoice.number}" %>

<div class="space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to "← Voltar", invoices_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <h1 class="text-xl font-semibold text-gray-900">NF <%= @invoice.number %></h1>
    <%= invoice_kind_badge(@invoice) %>
    <span id="invoice_status_badge_<%= @invoice.id %>"><%= payment_status_badge(@invoice) %></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Invoice details %>
    <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 p-6 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Centro de Custo</p>
          <p class="mt-1 font-medium text-gray-900">
            <%= link_to @invoice.cost_center.cr_code, cost_center_path(@invoice.cost_center),
                  class: "text-red-600 hover:underline" %>
            — <%= @invoice.cost_center.description %>
          </p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Cliente</p>
          <p class="mt-1 font-medium text-gray-900"><%= @invoice.client_name %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Data de Emissão</p>
          <p class="mt-1 font-medium text-gray-900"><%= @invoice.issued_at&.strftime("%d/%m/%Y") %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Valor da NF</p>
          <p class="mt-1 text-2xl font-bold text-gray-900"><%= brl(@invoice.value) %></p>
        </div>
        <div id="invoice_received_amount_<%= @invoice.id %>">
          <p class="text-xs text-gray-500 uppercase tracking-wide">Total Recebido</p>
          <p class="mt-1 font-medium text-green-700"><%= brl(@invoice.received_amount) %></p>
        </div>
        <div id="invoice_balance_<%= @invoice.id %>">
          <p class="text-xs text-gray-500 uppercase tracking-wide">Saldo em Aberto</p>
          <p class="mt-1 font-medium <%= @invoice.balance > 0 ? 'text-red-600' : 'text-green-600' %>">
            <%= brl(@invoice.balance) %>
          </p>
        </div>
        <% if @invoice.observations.present? %>
          <div class="sm:col-span-2">
            <p class="text-xs text-gray-500 uppercase tracking-wide">Observações</p>
            <p class="mt-1 text-gray-700"><%= @invoice.observations %></p>
          </div>
        <% end %>
      </div>

      <% if policy(@invoice).update? %>
        <div class="flex gap-3 pt-2 border-t border-gray-100">
          <%= link_to "Editar", edit_invoice_path(@invoice),
                class: "rounded-lg border border-gray-300 px-4 py-2 text-sm hover:bg-gray-50" %>
          <% if policy(@invoice).destroy? %>
            <%= button_to "Excluir", invoice_path(@invoice), method: :delete,
                  data: { turbo_confirm: "Confirma a exclusão desta nota fiscal?" },
                  class: "rounded-lg border border-red-300 px-4 py-2 text-sm text-red-600 hover:bg-red-50" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Open balance card — always render wrapper so turbo stream can target it %>
    <div id="invoice_partial_card_<%= @invoice.id %>">
      <% if @invoice.partially_paid? %>
        <div class="bg-orange-50 border border-orange-200 rounded-xl p-5 text-sm h-fit">
          <p class="font-semibold text-orange-800 mb-1">⚠️ Pagamento Parcial</p>
          <p class="text-orange-700">Esta nota foi parcialmente paga. Saldo restante:</p>
          <p class="text-2xl font-bold text-orange-900 mt-2"><%= brl(@invoice.balance) %></p>
        </div>
      <% end %>
    </div>
  </div>

  <%# Receipts section %>
  <div class="bg-white rounded-xl border border-gray-200">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="font-semibold text-gray-700 text-sm">Recebimentos</h2>
      <% if policy(Receipt).create? %>
        <%= link_to "Registrar Recebimento", new_invoice_receipt_path(@invoice),
              class: "rounded-lg bg-green-600 px-3 py-1.5 text-sm text-white hover:bg-green-700" %>
      <% end %>
    </div>

    <%= turbo_frame_tag "receipts_#{@invoice.id}" do %>
      <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="px-5 py-3 text-left">Data</th>
            <th class="px-5 py-3 text-right">Valor</th>
            <th class="px-5 py-3 text-left">Observações</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody id="receipts_body_<%= @invoice.id %>" class="divide-y divide-gray-100">
          <% if @receipts.any? %>
            <% @receipts.each do |receipt| %>
              <%= render "receipts/receipt_row", receipt: receipt %>
            <% end %>
          <% else %>
            <tr id="empty_receipts_<%= @invoice.id %>">
              <td colspan="4" class="py-8 text-center text-sm text-gray-400">
                Nenhum recebimento registrado.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
    <% end %>
  </div>
</div>
