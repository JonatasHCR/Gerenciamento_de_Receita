# Copie para .env e ajuste os valores.

# Conexão com o PostgreSQL (serviço "db" do docker-compose).
DATABASE_URL=postgres://receita:receita@db/receita_dev

# Chave para descriptografar config/credentials.yml.enc (config/master.key).
RAILS_MASTER_KEY=

# Backup automático (serviço "backup"): intervalo e quantos manter.
BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=14

# Produção: veja .env.production.example.

# --- SSO ---
# HOST_IP e mantido em dia por infra/scripts/sync_host_ip.py; edite no infra/.env.
# A porta entra no redirect URI do realm — os dois lados precisam concordar.
HOST_IP=

# Conta mestra: UM email, o mesmo nos tres sistemas, que entra como
# administrador aqui sem depender de grupo nem de script de promocao.
# Preenchido por `python infra/scripts/sync_host_ip.py` — nao edite a mao.
ADMIN_MESTRE_EMAIL=
KEYCLOAK_PORT=8080
RECEITA_PORT=3040
PORTAL_PORT=3080
OIDC_CLIENT_ID=receita-web
OIDC_CLIENT_SECRET=

# Token da API de sincronizacao (o inventario le os centros de custo daqui).
# Gere com: openssl rand -hex 32
SYNC_API_TOKEN=
