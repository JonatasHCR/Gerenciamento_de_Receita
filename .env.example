# Copie para .env e ajuste os valores.

# Conexão com o PostgreSQL (serviço "db" do docker-compose).
DATABASE_URL=postgres://receita:receita@db/receita_dev

# Chave para descriptografar config/credentials.yml.enc (config/master.key).
RAILS_MASTER_KEY=

# Backup automático (serviço "backup"): de quantas em quantas horas e quantos manter.
BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=14

# ── Produção (docker-compose.prod.yml) ───────────────────────────────────────
# WEB_IMAGE=registry.exemplo.com/owner/repo:latest
# POSTGRES_USER=receita
# POSTGRES_PASSWORD=troque-esta-senha
# POSTGRES_DB=receita_production
# RAILS_MAX_THREADS=5
# WEB_PORT=80
